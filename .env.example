# ---------------------------------------------------------------------------
# Lighthook environment variables
#
# LOCAL: copy this file to `.env` (gitignored) and fill in the values.
# Netlify does NOT read `.env`. Set every key below in
#   Site configuration -> Environment variables
# for Production (and Deploy Previews if you use them), then redeploy.
#
# `VITE_*` values are read by Vite at BUILD TIME and baked into the client
# bundle, so changing one requires a new deploy, not just a restart.
# ---------------------------------------------------------------------------

# --- Build-time (client bundle; public by design) --------------------------

# TMDB v4 Read Access Token (preferred).
VITE_TMDB_TOKEN=

# TMDB v3 API key (fallback when no v4 token is set).
VITE_TMDB_API_KEY=

# Sent by the browser as the x-family-key header. Must match FAMILY_KEY.
VITE_FAMILY_KEY=

# --- Server-side (Netlify Functions only; never shipped to the browser) ----

# Gate for /api/profiles. If unset, the function falls back to "samandmellu";
# set a real passphrase before deploying.
FAMILY_KEY=
